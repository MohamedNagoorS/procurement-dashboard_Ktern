<mvc:View
	controllerName="procurement.dashboard.controller.Detail"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:layout="sap.ui.layout"
	xmlns:form="sap.ui.layout.form"
	displayBlock="true">
	
	<Page
		id="detailPage"
		title="{i18n>detailTitle}"
		showNavButton="true"
		navButtonPress="onNavBack"
		class="detailPage">
		
		<content>
			<VBox>
				<!-- Header Section -->
				<VBox class="detailHeader">
					<Title text="{PONumber}" level="H2" class="detailHeaderTitle"/>
					<Text text="{i18n>detailHeaderInfo}" class="detailHeaderSubtitle"/>
				</VBox>
				
				<!-- Header Information -->
				<VBox class="detailSection">
					<Title text="{i18n>detailHeaderInfo}" level="H3" class="detailSectionTitle"/>
					<form:SimpleForm
						editable="false"
						layout="ResponsiveGridLayout"
						labelSpanXL="4"
						labelSpanL="4"
						labelSpanM="4"
						labelSpanS="12"
						emptySpanXL="0"
						emptySpanL="0"
						emptySpanM="0"
						emptySpanS="0"
						columnsXL="2"
						columnsL="2"
						columnsM="1">
						<form:content>
							<Label text="{i18n>tablePONumber}"/>
							<Text text="{PONumber}"/>
							
							<Label text="{i18n>tableStatus}"/>
							<ObjectStatus
								text="{
									path: 'Status',
									formatter: '.formatter.formatStatus'
								}"
								state="{
									path: 'Status',
									formatter: '.formatter.formatStatusState'
								}"/>
							
							<Label text="{i18n>tableCompanyCode}"/>
							<Text text="{CompanyCode}"/>
							
							<Label text="{i18n>tableNetAmount}"/>
							<ObjectNumber
								number="{
									parts: ['NetAmount', 'Currency'],
									formatter: '.formatter.formatCurrency'
								}"/>
							
							<Label text="{i18n>tableCurrency}"/>
							<Text text="{Currency}"/>
							
							<Label text="{i18n>tableDeliveryDate}"/>
							<Text text="{
								path: 'DeliveryDate',
								formatter: '.formatter.formatDeliveryDate'
							}"/>
							
							<Label text="{i18n>tableCreatedBy}"/>
							<Text text="{CreatedBy}"/>
							
							<Label text="{i18n>tableCreatedOn}"/>
							<Text text="{
								path: 'CreatedOn',
								formatter: '.formatter.formatDeliveryDate'
							}"/>
						</form:content>
					</form:SimpleForm>
				</VBox>
				
				<!-- Vendor Information -->
				<VBox class="detailSection">
					<Title text="{i18n>detailVendorInfo}" level="H3" class="detailSectionTitle"/>
					<form:SimpleForm
						editable="false"
						layout="ResponsiveGridLayout"
						labelSpanXL="4"
						labelSpanL="4"
						labelSpanM="4"
						labelSpanS="12"
						emptySpanXL="0"
						emptySpanL="0"
						emptySpanM="0"
						emptySpanS="0"
						columnsXL="2"
						columnsL="2"
						columnsM="1">
						<form:content>
							<Label text="{i18n>tableVendorName}"/>
							<Text text="{VendorName}"/>
							
							<Label text="Vendor Code"/>
							<Text text="{VendorCode}"/>
							
							<Label text="Contact Person"/>
							<Text text="{ContactPerson}"/>
							
							<Label text="Phone"/>
							<Text text="{Phone}"/>
						</form:content>
					</form:SimpleForm>
				</VBox>
				
			</VBox>
		</content>
		
		<footer>
			<Toolbar>
				<ToolbarSpacer/>
				<Button
					text="{i18n>detailBackButton}"
					press="onNavBack"/>
			</Toolbar>
		</footer>
	</Page>
</mvc:View>
