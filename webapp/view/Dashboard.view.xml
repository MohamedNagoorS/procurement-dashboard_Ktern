<mvc:View
	controllerName="procurement.dashboard.controller.Dashboard"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
	xmlns:layout="sap.ui.layout"
	xmlns:core="sap.ui.core"
	xmlns:viz="sap.viz.ui5.controls"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
	xmlns:viz.data="sap.viz.ui5.data"
	displayBlock="true">
	
	<Page
		id="dashboardPage"
		title="{i18n>dashboardTitle}"
		showNavButton="false"
		class="sapUiResponsiveContentPadding">
		
		<content>
			<VBox class="dashboardContainer">
				
				<!-- Page Header -->
				<layout:VerticalLayout class="sapUiSmallMarginBottom">
					<Title text="{i18n>dashboardTitle}" level="H1"/>
					<Text text="{i18n>dashboardSubtitle}" class="sapUiTinyMarginTop"/>
				</layout:VerticalLayout>
				
				<!-- KPI Cards Section -->
				<layout:Grid
					id="kpiGrid"
					class="kpiCardsContainer"
					defaultSpan="XL2 L2 M4 S12">
					
					<!-- Total POs Card -->
					<f:Card class="kpiCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>kpiTotalPOs}"
								iconSrc="sap-icon://document"
								press=".onKPICardPress">
								<card:customData>
									<core:CustomData key="filter" value="All"/>
								</card:customData>
							</card:Header>
						</f:header>
						<f:content>
							<VBox class="kpiCardContent" alignItems="Center">
								<Text text="{view>/kpiData/totalPOs}" class="kpiValue"/>
								<HBox class="kpiTrend" alignItems="Center">
									<core:Icon src="sap-icon://trend-up" size="1rem" color="#107e3e"/>
									<Text text="+5.2%" class="sapUiTinyMarginBegin kpiTrendUp"/>
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					
					<!-- Open POs Card -->
					<f:Card class="kpiCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>kpiOpenPOs}"
								iconSrc="sap-icon://open-command-field"
								press=".onKPICardPress">
								<card:customData>
									<core:CustomData key="filter" value="Open"/>
								</card:customData>
							</card:Header>
						</f:header>
						<f:content>
							<VBox class="kpiCardContent" alignItems="Center">
								<Text text="{view>/kpiData/openPOs}" class="kpiValue"/>
								<HBox class="kpiTrend" alignItems="Center">
									<core:Icon src="sap-icon://trend-up" size="1rem" color="#107e3e"/>
									<Text text="+2.1%" class="sapUiTinyMarginBegin kpiTrendUp"/>
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					
					<!-- Released POs Card -->
					<f:Card class="kpiCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>kpiReleasedPOs}"
								iconSrc="sap-icon://accept"
								press=".onKPICardPress">
								<card:customData>
									<core:CustomData key="filter" value="Released"/>
								</card:customData>
							</card:Header>
						</f:header>
						<f:content>
							<VBox class="kpiCardContent" alignItems="Center">
								<Text text="{view>/kpiData/releasedPOs}" class="kpiValue"/>
								<HBox class="kpiTrend" alignItems="Center">
									<core:Icon src="sap-icon://trend-up" size="1rem" color="#107e3e"/>
									<Text text="+8.5%" class="sapUiTinyMarginBegin kpiTrendUp"/>
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					
					<!-- Delayed Deliveries Card -->
					<f:Card class="kpiCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>kpiDelayedDeliveries}"
								iconSrc="sap-icon://alert"
								press=".onKPICardPress">
								<card:customData>
									<core:CustomData key="filter" value="Overdue"/>
								</card:customData>
							</card:Header>
						</f:header>
						<f:content>
							<VBox class="kpiCardContent" alignItems="Center">
								<Text text="{view>/kpiData/delayedDeliveries}" class="kpiValue"/>
								<HBox class="kpiTrend" alignItems="Center">
									<core:Icon src="sap-icon://trend-down" size="1rem" color="#bb0000"/>
									<Text text="-3.2%" class="sapUiTinyMarginBegin kpiTrendDown"/>
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					
					<!-- Total Amount Card -->
					<f:Card class="kpiCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>kpiTotalAmount}"
								iconSrc="sap-icon://money-bills"/>
						</f:header>
						<f:content>
							<VBox class="kpiCardContent" alignItems="Center">
								<Text text="{
									parts: ['view>/kpiData/totalAmount', 'view>/kpiData/currency'],
									formatter: '.formatter.formatCurrency'
								}" class="kpiValue"/>
								<HBox class="kpiTrend" alignItems="Center">
									<core:Icon src="sap-icon://trend-up" size="1rem" color="#107e3e"/>
									<Text text="+12.3%" class="sapUiTinyMarginBegin kpiTrendUp"/>
								</HBox>
							</VBox>
						</f:content>
					</f:Card>
					
				</layout:Grid>
				
				<!-- Analytics Section (Simplified without viz charts) -->
				<layout:Grid
					id="chartsGrid"
					defaultSpan="XL3 L3 M6 S12">
					
					<!-- PO Status Distribution -->
					<f:Card class="chartCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>chartStatusDistribution}"
								iconSrc="sap-icon://donut-chart"/>
						</f:header>
						<f:content>
							<viz:VizFrame id="statusChart" uiConfig="{applicationSet:'fiori'}" vizType="donut" height="300px" width="100%">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{view>/chartData/statusDistribution}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition name="Status" value="{view>status}"/>
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition name="Count" value="{view>count}"/>
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem uid="size" type="Measure" values="Count"/>
									<viz.feeds:FeedItem uid="color" type="Dimension" values="Status"/>
								</viz:feeds>
							</viz:VizFrame>
						</f:content>
					</f:Card>
					
					<!-- Monthly Procurement -->
					<f:Card class="chartCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>chartMonthlyProcurement}"
								iconSrc="sap-icon://bar-chart"/>
						</f:header>
						<f:content>
							<viz:VizFrame id="monthlyChart" uiConfig="{applicationSet:'fiori'}" vizType="column" height="300px" width="100%">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{view>/chartData/monthlyProcurement}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition name="Month" value="{view>month}"/>
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition name="Amount" value="{view>amount}"/>
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Amount"/>
									<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Month"/>
								</viz:feeds>
							</viz:VizFrame>
						</f:content>
					</f:Card>
					
					<!-- Vendor Analysis -->
					<f:Card class="chartCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>chartVendorAnalysis}"
								iconSrc="sap-icon://supplier"/>
						</f:header>
						<f:content>
							<viz:VizFrame id="vendorChart" uiConfig="{applicationSet:'fiori'}" vizType="bar" height="300px" width="100%">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{view>/chartData/vendorAnalysis}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition name="Vendor" value="{view>vendor}"/>
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition name="Count" value="{view>count}"/>
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Count"/>
									<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Vendor"/>
								</viz:feeds>
							</viz:VizFrame>
						</f:content>
					</f:Card>
					
					<!-- Company Code Distribution -->
					<f:Card class="chartCard fadeIn">
						<f:header>
							<card:Header
								title="{i18n>chartCompanyCode}"
								iconSrc="sap-icon://building"/>
						</f:header>
						<f:content>
							<viz:VizFrame id="companyCodeChart" uiConfig="{applicationSet:'fiori'}" vizType="bar" height="300px" width="100%">
								<viz:dataset>
									<viz.data:FlattenedDataset data="{view>/chartData/companyCodeDistribution}">
										<viz.data:dimensions>
											<viz.data:DimensionDefinition name="Company Code" value="{view>companyCode}"/>
										</viz.data:dimensions>
										<viz.data:measures>
											<viz.data:MeasureDefinition name="Count" value="{view>count}"/>
										</viz.data:measures>
									</viz.data:FlattenedDataset>
								</viz:dataset>
								<viz:feeds>
									<viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Count"/>
									<viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Company Code"/>
								</viz:feeds>
							</viz:VizFrame>
						</f:content>
					</f:Card>
					
				</layout:Grid>
				
				<!-- Purchase Orders Table -->
				<f:Card class="tableCard fadeIn">
					<f:header>
						<card:Header
							title="{i18n>tableTitle}"
							iconSrc="sap-icon://table-view"/>
					</f:header>
					<f:content>
						<VBox>
							<!-- Toolbar -->
							<OverflowToolbar class="tableToolbar">
								<SearchField
									id="searchField"
									width="400px"
									placeholder="{i18n>searchPlaceholder}"
									search="onSearch"/>
								<ToolbarSpacer/>
								<Button
									icon="sap-icon://filter"
									text="{i18n>filterButton}"
									press="onOpenFilterDialog"/>
								<Button
									icon="sap-icon://sort"
									text="{i18n>sortButton}"
									press="onOpenSortDialog"/>
								<Button
									icon="sap-icon://excel-attachment"
									text="{i18n>exportButton}"
									press="onExport"/>
								<Button
									icon="sap-icon://refresh"
									text="{i18n>refreshButton}"
									press="onRefresh"/>
							</OverflowToolbar>
							
							<!-- Table -->
							<table:Table
								xmlns:table="sap.ui.table"
								id="poTable"
								rows="{
									path: 'view>/purchaseOrders',
									sorter: {
										path: 'PONumber',
										descending: false
									}
								}"
								selectionMode="Single"
								selectionBehavior="RowOnly"
								visibleRowCount="10"
								rowSelectionChange="onSelectionChange"
								ariaLabelledBy="title">
								<table:columns>
									<table:Column width="10rem">
										<Label text="{i18n>tablePONumber}"/>
										<table:template>
											<ObjectIdentifier
												title="{view>PONumber}"
												text="{view>CreatedBy}"/>
										</table:template>
									</table:Column>
									<table:Column>
										<Label text="{i18n>tableVendorName}"/>
										<table:template>
											<Text text="{view>VendorName}"/>
										</table:template>
									</table:Column>
									<table:Column hAlign="Center">
										<Label text="{i18n>tableCompanyCode}"/>
										<table:template>
											<Text text="{view>CompanyCode}"/>
										</table:template>
									</table:Column>
									<table:Column hAlign="End">
										<Label text="{i18n>tableNetAmount}"/>
										<table:template>
											<ObjectNumber
												number="{
													parts: ['view>NetAmount', 'view>Currency'],
													formatter: '.formatter.formatCurrency'
												}"/>
										</table:template>
									</table:Column>
									<table:Column hAlign="Center">
										<Label text="{i18n>tableCurrency}"/>
										<table:template>
											<Text text="{view>Currency}"/>
										</table:template>
									</table:Column>
									<table:Column>
										<Label text="{i18n>tableDeliveryDate}"/>
										<table:template>
											<Text text="{
												path: 'view>DeliveryDate',
												formatter: '.formatter.formatDeliveryDate'
											}"/>
										</table:template>
									</table:Column>
									<table:Column hAlign="Center">
										<Label text="{i18n>tableStatus}"/>
										<table:template>
											<ObjectStatus
												text="{
													path: 'view>Status',
													formatter: '.formatter.formatStatus'
												}"
												state="{
													path: 'view>Status',
													formatter: '.formatter.formatStatusState'
												}"/>
										</table:template>
									</table:Column>
								</table:columns>
							</table:Table>
						</VBox>
					</f:content>
				</f:Card>
				
			</VBox>
		</content>
	</Page>
</mvc:View>
